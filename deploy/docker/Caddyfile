{
	email {$ACME_EMAIL}
}

{$CADDY_SCHEME:https://}{$APP_DOMAIN} {
	encode zstd gzip
	# Universal / App Links vouchers must be reachable on the dashboard host —
	# Apple and Google fetch them from the link's origin.
	handle /.well-known/* {
		reverse_proxy backend-v2:4104
	}
	handle /api-gateway/* {
		reverse_proxy backend-v2:4104
	}
	handle {
		reverse_proxy dashboard:3000
	}
}

{$CADDY_SCHEME:https://}{$GIT_DOMAIN} {
	encode zstd gzip
	reverse_proxy gitea:3000
}
