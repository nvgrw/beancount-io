# deploy/docker environment — copy to .env and replace every change-me value.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate secrets with `openssl rand -hex 32`. Hex values are also safe when
# Compose builds the PostgreSQL connection URI from the password.

# Source root relative to this Compose file. A flattened deployment bundle
# with source under ./source sets this to ./source.
SOURCE_ROOT=../..

# ── Public endpoints ────────────────────────────────────────────────────────
# Create an A/AAAA record for this name before starting Caddy. Do not include a
# scheme, slash, or port.
APP_DOMAIN=books.example.com

# ── Application secrets ────────────────────────────────────────────────────
AUTH_SECRET=change-me-auth-secret
# JSON array of cookie-signing secrets. Keep the outer JSON syntax intact.
COOKIE_SECRETS=["change-me-cookie-secret"]
# Shared by backend-v2 and ledger. Empty would make ledger-limit checks fail
# open, so the production Compose file requires a non-empty value.
ADMIN_TOKEN=change-me-admin-token
METRICS_API_TOKEN=change-me-metrics-token
# Optional Gitea-to-ledger webhook bearer token. The Python ledger is SHA-keyed
# and does not need push invalidation, but set this when enabling its webhook
# endpoints or pre-receive checks.
LEDGER_WEBHOOK_TOKEN=
AUTH_JWT_EXP_MINUTES=525600
# Disable billing and grant every local user unlimited tier quotas.
SELF_HOSTED_UNLIMITED=true
# Production OAuth signing JWKS (JSON). Required only when exposing Beancount's
# built-in OAuth provider. Cloudflare Access deployments use Managed OAuth at
# the edge and may leave this empty. Without either provider, native login is
# unavailable and Beancount's /oauth/* routes answer 503
# `oauth_not_configured`. Never commit a real keyset.
OAUTH_JWKS=

# Optional identity-aware deployment. Configure both values to accept only
# signed assertions for this Access application. The issuer is your Zero Trust
# team origin; the audience is the application's AUD tag.
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_AUDIENCE=

# Gitea admin account used by backend-v2. The one-shot gitea-init service
# creates this user on first boot.
FAVA_API_ADMIN_USER=beancount_admin
FAVA_API_ADMIN_PASSWORD=change-me-gitea-admin-password
GITEA_ADMIN_EMAIL=admin@example.com

# ── Data stores ─────────────────────────────────────────────────────────────
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-gitea-database-password
GITEA_DB_NAME=gitea
BACKEND_DB_USER=beancount
BACKEND_DB_PASSWORD=change-me-backend-database-password
BACKEND_DB_NAME=beancount

# These values protect persisted Gitea sessions, tokens, and LFS credentials.
# Do not rotate them casually after first boot.
GITEA_SECRET_KEY=change-me-gitea-secret-key
GITEA_INTERNAL_TOKEN=change-me-gitea-internal-token
GITEA_LFS_JWT_SECRET=change-me-gitea-lfs-jwt-secret
GITEA_OAUTH2_JWT_SECRET=change-me-gitea-oauth2-jwt-secret

# ── Image tracks ────────────────────────────────────────────────────────────
# The target server is x86_64. This also makes builds performed on Apple Silicon
# produce images that can be transferred to and run on the target server.
DOCKER_PLATFORM=linux/amd64
# These defaults follow patch releases within tested major/minor lines. Pin a
# full tag or digest here when your deployment policy requires immutability.
CADDY_IMAGE=caddy:2-alpine
GITEA_IMAGE=docker.gitea.com/gitea:1.24
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
BEANCOUNT_IMAGE_TAG=selfhosted

# ── AI features (optional) ──────────────────────────────────────────────────
# All AI vars may stay empty: the server boots without them and AI calls fail
# with a clear "LLM is not configured" error (ADR 0011). ANTHROPIC_API_KEY
# (primary) / OPENAI_API_KEY (fallback) enable receipt & file parsing,
# category suggestions, Plaid AI, and the agent chat. BLOCKEDEN_ACCESS_KEY
# only meters the `bea ask` model proxy (/api-gateway/ai/openai/…).
BLOCKEDEN_ACCESS_KEY=
ANTHROPIC_API_KEY=
# Do not set ANTHROPIC_BASE_URL to an empty string; see README.md.
OPENAI_API_KEY=
# Model ids are optional; defaults are claude-sonnet-4-5 (primary) / gpt-4o
# (fallback). Set to upgrade without a code change. Not ANTHROPIC_MODEL —
# that name is used by the Ask-AI sandbox path.
LLM_MODEL=
LLM_FALLBACK_MODEL=
ASK_AI_MODE=bql
AGENT_MODE=self-hosted
CLAUDE_CODE_SANDBOX_URL=
CLAUDE_CODE_AGENT_URL=

# ── Optional integrations ───────────────────────────────────────────────────
SEND_GRID_API_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEV_PUBLIC_KEY=
STRIPE_DEV_PRIVATE_KEY=
STRIPE_DEV_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=
TEMP_ASSETS_AWS_S3_REGION=us-east-1
TEMP_ASSETS_AWS_S3_BUCKET=
TEMP_ASSETS_AWS_S3_ACCESS_KEY_ID=
TEMP_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
TEMP_ASSETS_AWS_S3_ENDPOINT=
PERM_ASSETS_AWS_S3_REGION=us-east-1
PERM_ASSETS_AWS_S3_BUCKET=
PERM_ASSETS_AWS_S3_ACCESS_KEY_ID=
PERM_ASSETS_AWS_S3_SECRET_ACCESS_KEY=
PERM_ASSETS_AWS_S3_ENDPOINT=
LOKI_HOST=
LOG_LEVEL=info

# ── Native app links (optional) ─────────────────────────────────────────────
# Serve /.well-known/apple-app-site-association and assetlinks.json so
# https://<APP_DOMAIN>/ledger/... can open the native apps. Unset → those
# routes 404 (correct for a self-host without a store build). Beancount.io
# production uses APP_LINKS_APPLE_TEAM_ID=PTLM7BZQMM; set APP_LINKS_ANDROID_SHA256
# to the Play App Signing certificate fingerprint(s), comma-separated.
APP_LINKS_APPLE_TEAM_ID=
APP_LINKS_IOS_BUNDLE_ID=io.beancount.ios
APP_LINKS_ANDROID_SHA256=
APP_LINKS_ANDROID_PACKAGE=io.beancount.android

# ── Git over SSH (optional) ─────────────────────────────────────────────────
# HTTP Git works without these. See README.md before enabling the SSH override.
SSH_PORT=2222
SSH_PROXY_HOST_KEY=
